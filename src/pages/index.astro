---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import logoSymbol from '../assets/images/logo-symbol.png';
---

<Layout 
  title="Halaqoh: Coming Soon" 
  description="Aplikasi pencatatan absensi dan setoran santri modern, luring (offline-first), dan transparan untuk TPA, TPQ, dan Pondok Pesantren. Segera hadir."
  hideChrome={true}
>
  <div class="coming-soon-wrapper">
    <div class="coming-soon-card">
      <div class="logo-wrap">
        <Image
          src={logoSymbol}
          alt="Logo Halaqoh"
          width={512}
          height={512}
          quality="max"
          loading="eager"
          fetchpriority="high"
          class="coming-soon-logo"
        />
      </div>
      <h1 class="coming-soon-heading">Coming Soon</h1>
    </div>
  </div>
</Layout>

<style>
  :global(html),
  :global(body.coming-soon-body) {
    background-color: #ffffff !important;
    background: #ffffff !important;
    color: #111111 !important;
    margin: 0 !important;
    padding: 0 !important;
    min-height: 100dvh;
    width: 100%;
    overflow-x: hidden;
  }

  .coming-soon-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100dvh;
    width: 100%;
    padding: 2rem 1.5rem;
    padding-top: max(2rem, env(safe-area-inset-top));
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
    padding-left: max(1.5rem, env(safe-area-inset-left));
    padding-right: max(1.5rem, env(safe-area-inset-right));
    box-sizing: border-box;
    background-color: #ffffff;
  }

  .coming-soon-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    max-width: 480px;
    width: 100%;
    animation: fadeIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .coming-soon-logo {
    /* Responsive sizing optimal for Android & iPhone viewports as well as desktop */
    width: clamp(160px, 48vw, 240px);
    height: auto;
    max-height: 40vh;
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  .coming-soon-heading {
    margin: clamp(1.75rem, 4vh, 2.75rem) 0 0 0;
    font-family: var(--font, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: clamp(1.25rem, 3.8vw, 1.875rem);
    font-weight: 500;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #171717;
    /* Mathematical compensation for right letter-spacing to ensure absolute center alignment */
    padding-left: 0.28em;
    line-height: 1.2;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coming-soon-card {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
