---
// Security & Privacy component in Tengile MalaMala minimalist luxury style
const points = [
  {
    title: "Privasi Santri dari Mesin Pencari",
    desc: "Seluruh halaman profil santri diproteksi instruksi anti-perayapan robot (noindex, nofollow). Nama dan rekap hafalan anak tidak akan terindeks atau muncul dalam hasil pencarian Google."
  },
  {
    title: "Tautan Acak Kriptografis Tanpa Paparan Kontak",
    desc: "Setiap profil santri menggunakan slug unik dengan 6 karakter acak kriptografis. Halaman publik hanya menampilkan rekaman hafalan tanpa membocorkan nomor kontak atau alamat rumah."
  },
  {
    title: "Enkripsi Kata Sandi Standar Industri",
    desc: "Kata sandi pengajar dan pengurus dienkripsi menggunakan algoritma bcrypt (cost 10) dengan proteksi timing attack. Kredensial tidak pernah disimpan dalam bentuk teks biasa."
  },
  {
    title: "Proteksi Sesi & Cookie HTTP-Only",
    desc: "Autentikasi menggunakan token acak 32-byte yang terisolasi dalam cookie httpOnly, Secure, dan SameSite. Hal ini melindungi akun staf dari upaya pencurian sesi oleh skrip berbahaya."
  },
  {
    title: "Verifikasi Asal Permintaan & Anti-Brute Force",
    desc: "Semua aksi simpan dan hapus diverifikasi asal permintaannya (strict same-origin) untuk menangkal CSRF. Sistem login juga otomatis mengunci percobaan tebak sandi yang mencurigakan."
  },
  {
    title: "Pembatas Laju Trafik Publik (Rate Limiting)",
    desc: "Akses ke halaman publik santri dipagari pembatas laju per alamat IP untuk menjaga ketersediaan server dari lonjakan trafik tidak wajar dan pemindaian otomatis."
  }
];
---

<section id="keamanan" class="py-24 md:py-36 bg-[var(--tm-dark-surface)] border-b border-white/10">
  <div class="container-tm">
    <div class="max-w-3xl mb-16">
      <span class="suptitle-tm">Integritas &amp; Keamanan</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[var(--tm-stone)] leading-tight mb-4">
        Amanah Menjaga Privasi &amp; Data Anak
      </h2>
      <p class="text-sm md:text-base text-[var(--tm-stone)]/80 font-light leading-relaxed">
        Kami memperlakukan setiap catatan ibadah dan tumbuh kembang santri dengan kehormatan tertinggi dan perlindungan arsitektur yang kokoh.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {points.map((item, idx) => (
        <div class="border-t border-white/15 pt-6">
          <span class="text-xs uppercase tracking-[0.2em] text-[var(--tm-accent-gold)] font-medium block mb-3">
            0{idx + 1} &bull; Proteksi Sistem
          </span>
          <h3 class="font-serif text-2xl text-white mb-3">
            {item.title}
          </h3>
          <p class="text-xs sm:text-sm text-[var(--tm-stone)]/80 font-light leading-relaxed">
            {item.desc}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
