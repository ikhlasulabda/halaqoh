---
import LiveSessionCard from './LiveSessionCard';
---

<section class="hero-section py-12 sm:py-16 md:py-20 relative" id="top">
  <div class="container grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-10 lg:gap-14 items-center">
    <div class="hero-content flex flex-col gap-6">
      <div>
        <span class="badge-tag">
          Sistem Pengajian TPA, TPQ & Masjid
        </span>
      </div>

      <h1 class="hero-title text-[clamp(2.3rem,4.5vw,3.5rem)] leading-[1.1] text-[var(--ink)]">
        Catat Kehadiran & Setoran Ngaji. <span class="highlight-text relative inline-block text-[var(--forest)]">
          Rapi, Cepat,
          <span class="absolute -left-0.5 -right-0.5 bottom-1 h-3.5 bg-[var(--hl-olive)] -z-10 rounded-sm -rotate-[0.8deg]"></span>
        </span> dan Transparan.
      </h1>

      <p class="hero-description text-[1.125rem] leading-[1.65] text-[var(--ink-secondary)] max-w-[580px]">
        Aplikasi pencatatan Iqro dan Al-Qur'an santri yang tetap bekerja lancar meski tanpa internet di dalam masjid. Bagikan progres anak langsung ke orang tua tanpa perlu repot membuat akun atau mengingat kata sandi.
      </p>

      <div class="hero-cta-group flex flex-wrap gap-4 items-center mt-2">
        <a href="#peran" class="btn btn-primary btn-lg min-h-[48px]" id="btn-hero-explore">
          Jelajahi Antarmuka
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#fitur" class="btn btn-secondary btn-lg min-h-[48px]">
          Pelajari Fitur
        </a>
      </div>

      <div class="hero-pills-row flex flex-wrap gap-3 mt-4 pt-5 border-t border-dashed border-[var(--border-soft)]">
        <div class="trust-pill inline-flex items-center gap-1.5 text-[0.825rem] font-medium text-[var(--ink-muted)]">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--forest)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Offline-First (Tanpa Internet)</span>
        </div>
        <div class="trust-pill inline-flex items-center gap-1.5 text-[0.825rem] font-medium text-[var(--ink-muted)]">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--forest)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Orang Tua Tanpa Perlu Login</span>
        </div>
        <div class="trust-pill inline-flex items-center gap-1.5 text-[0.825rem] font-medium text-[var(--ink-muted)]">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--forest)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>Laporan PDF 1-Klik Siap Cetak</span>
        </div>
      </div>
    </div>

    <!-- Live Interactive Session Island -->
    <div class="hero-visual-wrapper">
      <LiveSessionCard client:load />
    </div>
  </div>
</section>
