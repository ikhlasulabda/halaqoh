---
// Luxury Video Hero component inspired by Tengile MalaMala Collection
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-24 pb-16" id="top">
  <!-- Background Video Container -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <video
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      class="w-full h-full object-cover object-center scale-105 filter brightness-[0.6] contrast-[1.1]"
      src="/video.mp4"
    >
      <track kind="captions" srclang="id" label="Bahasa Indonesia" />
    </video>
    <!-- Multi-layered atmospheric vignette overlays -->
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--tm-dark)] via-transparent to-[var(--tm-dark)]/60 pointer-events-none"></div>
    <div class="absolute inset-0 bg-radial from-transparent via-[var(--tm-dark)]/40 to-[var(--tm-dark)]/90 pointer-events-none"></div>
  </div>

  <!-- Content Layer -->
  <div class="container-tm relative z-10 text-center flex flex-col items-center max-w-5xl mx-auto px-4">
    <!-- Category Suptitle -->
    <span class="suptitle-tm animate-fade-in tracking-[0.25em] mb-4">
      Pengajian &bull; Setoran &bull; Transparansi
    </span>

    <!-- Grand High-Fashion Serif Headline -->
    <h1 class="font-serif text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-normal text-[var(--tm-stone)] leading-[1.02] tracking-[-0.01em] uppercase mb-8 max-w-4xl">
      Kedalaman Bacaan &amp;<br class="hidden sm:inline" />
      <span class="italic font-light text-[var(--tm-white)]">Ketertiban Santri</span>
    </h1>

    <!-- Editorial Subtitle -->
    <p class="text-base sm:text-lg md:text-xl text-[var(--tm-stone)]/90 font-sans max-w-2xl mx-auto font-light leading-relaxed mb-10 tracking-normal">
      Sebuah ikhtiar menghadirkan pencatatan presensi dan setoran santri yang khusyuk, tertib, dan transparan bagi setiap orang tua: bekerja luring tanpa ketergantungan sinyal internet.
    </p>

    <!-- Call to Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
      <a href="#demo" class="btn-pill btn-pill-light w-full sm:w-auto text-xs tracking-[0.16em]">
        <span>Jelajahi Simulasi</span>
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <a href="#pilar" class="btn-pill btn-pill-outline w-full sm:w-auto text-xs tracking-[0.16em]">
        <span>Tiga Pilar Akses</span>
      </a>
    </div>

    <!-- Video Ambient Indicator -->
    <div class="mt-16 sm:mt-24 flex items-center gap-3 text-[0.6875rem] uppercase tracking-[0.2em] text-[var(--tm-stone)]/70 font-sans">
      <span class="w-2 h-2 rounded-full bg-[var(--tm-accent-gold)] animate-pulse"></span>
      <span>Suasana Musholla &amp; Halaqoh</span>
    </div>
  </div>
</section>
