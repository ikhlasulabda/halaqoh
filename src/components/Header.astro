---
// Header navigasi Halaqoh dengan logo resmi favicon.png di pojok kiri atas
---

<header class="site-header" id="top">
  <div class="container site-header__inner">
    <a href="#top" class="brand" aria-label="Beranda Halaqoh">
      <span class="brand-logo" aria-hidden="true">
        <img src="/favicon.png" alt="Halaqoh" width="396" height="134" loading="eager" />
      </span>
      <span class="sr-only">Halaqoh</span>
    </a>

    <nav class="site-nav" aria-label="Navigasi Utama">
      <a href="#demo">Demo Interaktif</a>
      <a href="#peran">Alur &amp; Peran</a>
      <a href="#offline">Dukungan Luring</a>
      <a href="#fitur">Fitur Lengkap</a>
      <a href="#faq">Tanya Jawab</a>
    </nav>

    <div class="site-header__cta">
      <a href="mailto:dundunmaju@gmail.com" class="btn btn-outline" style="min-height: 40px; padding: 0 16px; font-size: 0.9375rem;">
        Hubungi Pengembang
      </a>
    </div>

    <button
      type="button"
      class="menu-toggle"
      id="menu-toggle-btn"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Buka menu navigasi"
    >
      <span class="menu-toggle__bars" aria-hidden="true"></span>
      <span>Menu</span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-menu" aria-label="Menu Ponsel" hidden>
    <div class="container">
      <ul>
        <li><a href="#demo" class="mobile-link">Demo Interaktif</a></li>
        <li><a href="#peran" class="mobile-link">Alur &amp; Peran</a></li>
        <li><a href="#offline" class="mobile-link">Dukungan Luring</a></li>
        <li><a href="#fitur" class="mobile-link">Fitur Lengkap</a></li>
        <li><a href="#faq" class="mobile-link">Tanya Jawab</a></li>
      </ul>
      <a href="mailto:dundunmaju@gmail.com" class="btn btn-block" style="margin-top: 12px; margin-bottom: 12px;">
        Hubungi Pengembang
      </a>
    </div>
  </nav>
</header>

<script>
  const toggleBtn = document.getElementById('menu-toggle-btn');
  const mobileNav = document.getElementById('mobile-nav');

  if (toggleBtn && mobileNav) {
    const setOpen = (open: boolean) => {
      toggleBtn.setAttribute('aria-expanded', String(open));
      toggleBtn.setAttribute('aria-label', open ? 'Tutup menu navigasi' : 'Buka menu navigasi');
      if (open) {
        mobileNav.removeAttribute('hidden');
      } else {
        mobileNav.setAttribute('hidden', '');
      }
    };

    toggleBtn.addEventListener('click', () => {
      const isOpen = toggleBtn.getAttribute('aria-expanded') === 'true';
      setOpen(!isOpen);
    });

    // Tutup saat tautan diklik
    mobileNav.querySelectorAll('.mobile-link').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    // Tutup via tombol Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggleBtn.focus();
      }
    });
  }
</script>
