---
// Three Pillars of Access section inspired by Tengile MalaMala's SectionAccommodations
const pillars = [
  {
    role: "Ustadz & Guru Pengajar",
    pill: "Offline-First PWA",
    title: "Presensi Cepat di Musholla",
    desc: "Guru menyimak tilawah dan mencatat kehadiran tanpa hambatan sinyal. Tersedia kurikulum lengkap Iqro jilid 1 sampai 6, 114 surat Al-Qur'an dengan batas ayat riil, serta mode tahsin maupun setoran.",
    detail: "Mendukung multi-catatan dalam satu sesi kehadiran."
  },
  {
    role: "Wali & Orang Tua Santri",
    pill: "Akses Publik Tanpa Login",
    title: "Transparansi ke Tangan Orang Tua",
    desc: "Wali santri cukup membuka tautan slug acak via WhatsApp tanpa perlu membuat akun atau menghafal kata sandi. Dilengkapi tab multi-anak untuk keluarga serta unduhan laporan PDF standar A4 Landscape resmi.",
    detail: "Bebas dari perayapan bot mesin pencari Google demi privasi anak."
  },
  {
    role: "Pengurus & Administrator",
    pill: "Kedaulatan Mandiri",
    title: "Kendali Penuh Jadwal & Data",
    desc: "Admin mengatur kalender mingguan, hari libur, jadwal shalat, serta pendaftaran santri baru. Dilengkapi cadangan database JSON utuh, ekspor CSV aman formula injection, dan pemulihan atomik terverifikasi.",
    detail: "Pemisahan hak akses ketat dengan audit log aktivitas sistem."
  }
];
---

<section id="pilar" class="py-24 md:py-36 bg-[var(--tm-dark)] border-b border-white/10">
  <div class="container-tm">
    
    <!-- Section Header in Tengile MalaMala Asymmetric Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mb-16 items-end">
      <div class="lg:col-span-6">
        <span class="suptitle-tm">Tiga Sudut Pandang</span>
        <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[var(--tm-stone)] leading-tight">
          Satu Sistem Terpadu untuk Tiga Peran Utama
        </h2>
      </div>
      <div class="lg:col-span-6">
        <p class="text-sm md:text-base text-[var(--tm-stone)]/80 font-light leading-relaxed">
          Setiap pihak mendapatkan antarmuka yang dirancang presisi sesuai kebutuhan nyata: guru yang membutuhkan kecepatan input di halaqoh, orang tua yang menanti kabar perkembangan putra-putrinya, dan pengurus yang menjaga amanah data.
        </p>
      </div>
    </div>

    <!-- Action Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {pillars.map((item, idx) => (
        <div class="bg-[var(--tm-dark-surface)] border border-white/10 rounded-2xl p-8 flex flex-col justify-between hover:border-[var(--tm-accent-gold)]/40 transition-all duration-300 group shadow-lg">
          <div>
            <div class="flex items-center justify-between gap-4 mb-6">
              <span class="text-xs uppercase tracking-[0.18em] text-[var(--tm-accent-gold)] font-medium">
                0{idx + 1} &bull; {item.role}
              </span>
              <span class="text-[0.6875rem] uppercase tracking-wider px-3 py-1 rounded-full bg-white/5 text-[var(--tm-stone)] border border-white/10">
                {item.pill}
              </span>
            </div>

            <h3 class="font-serif text-2xl text-white mb-4 group-hover:text-[var(--tm-accent-gold)] transition-colors">
              {item.title}
            </h3>

            <p class="text-xs sm:text-sm text-[var(--tm-stone)]/80 leading-relaxed font-light mb-8">
              {item.desc}
            </p>
          </div>

          <div class="pt-6 border-t border-white/10 flex items-center justify-between text-xs text-[var(--tm-accent-gold)]">
            <span class="font-sans font-medium">{item.detail}</span>
            <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
