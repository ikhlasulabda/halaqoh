---
// Technical Pillars component in Tengile MalaMala minimalist editorial styling
const features = [
  {
    num: "01",
    tag: "Offline-First",
    title: "Pencatatan Luring Tanpa Internet",
    desc: "Guru tetap dapat mencatat presensi dan setoran santri di dalam musholla tanpa sinyal internet. Seluruh data tersimpan aman di IndexedDB peramban dan otomatis disinkronkan saat terhubung kembali."
  },
  {
    num: "02",
    tag: "Kurikulum Tervalidasi",
    title: "Iqro 1-6 & 114 Surat Al-Qur'an",
    desc: "Memuat basis data tervalidasi seluruh surat Al-Qur'an dengan batas ayat riil, nomor halaman mushaf standar (1-604), serta jilid Iqro. Mendukung metode bimbingan tahsin dan setoran hafalan mandiri."
  },
  {
    num: "03",
    tag: "Siklus Shalat",
    title: "Deteksi Otomatis 5 Sesi Waktu",
    desc: "Sistem mendeteksi waktu Subuh, Zuhur, Ashar, Magrib, dan Isya secara aktual sesuai jam server Asia/Jakarta. Tersedia peralihan manual fleksibel untuk kelas pengajian di luar jam reguler."
  },
  {
    num: "04",
    tag: "Dokumen Resmi",
    title: "Generator PDF Standar A4 Landscape",
    desc: "Hasilkan lembar rekapitulasi santri siap cetak beresolusi tinggi langsung dari peramban. Menggunakan mesin binary PDF 1.4 murni tanpa ketergantungan library luar yang membebani gawai."
  },
  {
    num: "05",
    tag: "Akses Terbuka",
    title: "Tautan Publik Aman Tanpa Sandi",
    desc: "Wali santri tidak perlu repot membuat akun atau mengingat sandi. Cukup buka tautan slug unik yang diacak secara kriptografis, lengkap dengan dukungan multi-anak dalam satu layar."
  },
  {
    num: "06",
    tag: "Kedaulatan Mandiri",
    title: "Cadangan Mandiri JSON & Ekspor CSV",
    desc: "Pengurus memegang kendali penuh atas data santri. Unduh cadangan database komprehensif dalam format JSON dan ekspor CSV yang aman dari formula injection untuk Microsoft Excel."
  }
];
---

<section id="spesifikasi" class="py-24 md:py-36 bg-[var(--tm-dark)] border-b border-white/10">
  <div class="container-tm">
    <div class="max-w-3xl mb-16">
      <span class="suptitle-tm">Standar Rekayasa</span>
      <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-[var(--tm-stone)] leading-tight mb-4">
        Fondasi Kuat untuk Keberlanjutan Sistem
      </h2>
      <p class="text-sm md:text-base text-[var(--tm-stone)]/80 font-light leading-relaxed">
        Setiap kapabilitas teknis dibangun untuk menghadirkan kenyamanan nyata, bukan sekadar janji fitur di atas kertas.
      </p>
    </div>

    <!-- Editorial 3-col Grid with Hairline Dividers -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-white/10 rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
      {features.map((feat) => (
        <div class="bg-[var(--tm-dark)] p-8 sm:p-10 flex flex-col justify-between hover:bg-[var(--tm-dark-surface)] transition-colors duration-300">
          <div>
            <div class="flex items-center justify-between mb-8">
              <span class="font-serif text-2xl text-[var(--tm-accent-gold)] font-light">
                {feat.num}
              </span>
              <span class="text-[0.6875rem] uppercase tracking-wider text-[var(--tm-stone)]/60 px-3 py-1 rounded-full border border-white/10">
                {feat.tag}
              </span>
            </div>
            <h3 class="font-serif text-2xl text-white mb-4 leading-snug">
              {feat.title}
            </h3>
            <p class="text-xs sm:text-sm text-[var(--tm-stone)]/80 font-light leading-relaxed mb-6">
              {feat.desc}
            </p>
          </div>
          <div class="pt-4 border-t border-white/10 flex items-center gap-2 text-xs text-[var(--tm-accent-gold)]">
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--tm-accent-gold)]"></span>
            <span>Terverifikasi dalam kode sistem</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
