---
// Features Grid component: 6 Core Engineering Pillars of Halaqoh
const features = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
    tag: "Offline-First",
    title: "Pencatatan Luring Tanpa Gangguan",
    description: "Guru tetap dapat mencatat absensi dan setoran santri di dalam musholla tanpa sinyal internet. Data tersimpan di IndexedDB lokal dan tersinkronisasi otomatis saat terhubung kembali.",
    detail: "Mekanisme queue otomatis dengan deteksi status online peramban."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`,
    tag: "Kurikulum Komprehensif",
    title: "Iqro 1-6 dan 114 Surat Al-Qur'an",
    description: "Database tervalidasi memuat seluruh surat Al-Qur'an dengan batas ayat riil, nomor halaman mushaf standar (1-604), serta jilid Iqro. Mendukung metode tahsin bimbingan dan hafalan mandiri.",
    detail: "Validasi ketat mencegah salah input nomor ayat atau halaman."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`,
    tag: "Siklus Shalat",
    title: "Deteksi Otomatis 5 Sesi Waktu",
    description: "Sistem cerdas mendeteksi waktu Subuh, Zuhur, Ashar, Magrib, dan Isya secara aktual sesuai jam halaqoh. Tersedia peralihan manual fleksibel untuk kelas di luar jam reguler.",
    detail: "Terkonfigurasi presisi waktu server Asia/Jakarta."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />`,
    tag: "Dokumen Resmi",
    title: "Generator PDF Standar A4 Landscape",
    description: "Hasilkan lembar rekapitulasi santri siap cetak beresolusi tinggi langsung dari browser. Menggunakan mesin binary PDF 1.4 murni tanpa ketergantungan library luar yang membebani gawai.",
    detail: "Dilengkapi watermark keaslian dan rincian waktu unduh resmi."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />`,
    tag: "Akses Orang Tua",
    title: "Tautan Publik Aman Tanpa Kata Sandi",
    description: "Wali santri tidak perlu repot membuat akun atau mengingat sandi. Cukup buka tautan slug unik yang diacak secara kriptografis, lengkap dengan dukungan multi-anak dalam satu layar.",
    detail: "Dilindungi rate limiting dan bebas dari perayapan bot Google."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />`,
    tag: "Kedaulatan Data",
    title: "Cadangan Mandiri JSON & Ekspor CSV",
    description: "Pengurus memegang kendali penuh atas data santri. Unduh cadangan database komprehensif dalam format JSON dan ekspor CSV yang aman dari formula injection untuk Microsoft Excel.",
    detail: "Pemulihan database atomik terverifikasi dengan schema Zod."
  }
];
---

<section id="fitur" class="section-space bg-[var(--paper)] border-y border-[var(--border-soft)]">
  <div class="container scroll-reveal">
    <div class="section-head">
      <span class="section-eyebrow">Kapabilitas Teknis</span>
      <h2 class="section-title">Fondasi Nyata untuk Operasional Pengajian</h2>
      <p class="section-subtitle">
        Bukan konsep atau rancangan masa depan. Setiap kapabilitas di bawah ini telah teruji menangani pencatatan ratusan santri secara presisi.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feat) => (
        <div class="bg-[var(--cream)] border-2 border-[var(--border-strong)] rounded-[var(--radius-lg)] p-6 shadow-[var(--shadow-sm)] hover:shadow-[var(--shadow-md)] hover:-translate-y-1 transition-all duration-200 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="inline-flex items-center justify-center w-11 h-11 rounded-[var(--radius-md)] bg-[var(--sand)] text-[var(--forest)] border border-[var(--border-strong)]">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={feat.icon} />
              </span>
              <span class="text-[0.725rem] font-bold uppercase tracking-wider px-2.5 py-1 rounded-[var(--radius-pill)] bg-[var(--paper)] text-[var(--ink-secondary)] border border-[var(--border-soft)]">
                {feat.tag}
              </span>
            </div>
            <h3 class="text-xl font-bold mb-2.5 text-[var(--ink)] leading-snug">
              {feat.title}
            </h3>
            <p class="text-sm text-[var(--ink-secondary)] leading-relaxed mb-4">
              {feat.description}
            </p>
          </div>
          <div class="pt-3 border-t border-[var(--border-soft)] flex items-center gap-2 text-xs font-semibold text-[var(--forest)]">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>{feat.detail}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
