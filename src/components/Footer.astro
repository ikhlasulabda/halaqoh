---
// Footer component: tactile craft footer with official emblem and navigation
import { Image } from 'astro:assets';
import logoLandscape from '../assets/images/logo-brand.png';

const currentYear = 2026;
---

<footer class="bg-[var(--sand)] border-t-2 border-[var(--border-strong)] pt-12 pb-8">
  <div class="container">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-[var(--border-strong)]/20">
      <!-- Col 1: Brand Info -->
      <div class="md:col-span-2 flex flex-col items-start gap-4">
        <a href="#top" class="inline-flex items-center gap-3">
          <Image
            src={logoLandscape}
            alt="Logo Resmi Halaqoh"
            class="h-10 w-auto object-contain"
            width={240}
            height={90}
          />
        </a>
        <p class="text-sm text-[var(--ink-secondary)] leading-relaxed max-w-md">
          Platform manajemen pengajian santri ramah luring (offline-first). Dirancang khusus untuk TPA, musholla, dan majelis ilmu yang mengutamakan ketertiban administrasi serta transparansi bagi para wali santri.
        </p>
        <div class="flex items-center gap-2 text-xs font-semibold text-[var(--forest)]">
          <span class="w-2 h-2 rounded-full bg-[var(--forest)]"></span>
          <span>Bekerja mandiri tanpa ketergantungan sinyal internet</span>
        </div>
      </div>

      <!-- Col 2: Navigasi Cepat -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--ink)] mb-4">Navigasi Halaman</h4>
        <ul class="flex flex-col gap-2.5 text-sm font-medium text-[var(--ink-secondary)]">
          <li><a href="#top" class="hover:text-[var(--forest)] transition-colors">Beranda</a></li>
          <li><a href="#demo" class="hover:text-[var(--forest)] transition-colors">Simulasi 3 Peran</a></li>
          <li><a href="#fitur" class="hover:text-[var(--forest)] transition-colors">Kapabilitas Teknis</a></li>
          <li><a href="#alur" class="hover:text-[var(--forest)] transition-colors">Alur Operasional</a></li>
          <li><a href="#keamanan" class="hover:text-[var(--forest)] transition-colors">Keamanan & Privasi</a></li>
          <li><a href="#faq" class="hover:text-[var(--forest)] transition-colors">Pertanyaan Umum</a></li>
        </ul>
      </div>

      <!-- Col 3: Standar Rekayasa -->
      <div>
        <h4 class="text-xs font-bold uppercase tracking-wider text-[var(--ink)] mb-4">Arsitektur Rekayasa</h4>
        <ul class="flex flex-col gap-2.5 text-xs text-[var(--ink-secondary)] leading-relaxed">
          <li class="flex items-start gap-2">
            <span class="text-[var(--forest)] font-bold">&bull;</span>
            <span><strong>Offline-First:</strong> Serwist Service Worker & IndexedDB</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[var(--forest)] font-bold">&bull;</span>
            <span><strong>PDF Engine:</strong> Standar binary PDF 1.4 zero-dependency</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[var(--forest)] font-bold">&bull;</span>
            <span><strong>Sandi & Sesi:</strong> Bcrypt hash, HTTP-only SameSite cookie</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-[var(--forest)] font-bold">&bull;</span>
            <span><strong>Akses Publik:</strong> Kriptografis slug acak tanpa login</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[var(--ink-muted)]">
      <p>
        &copy; {currentYear} Halaqoh. Berakar dari amanah pendidikan pengajian santri.
      </p>
      <div class="flex items-center gap-4">
        <a href="#top" class="hover:text-[var(--ink)] font-semibold transition-colors flex items-center gap-1">
          <span>Kembali ke Atas</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
