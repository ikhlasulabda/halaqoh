---
// Workflow component: Visual 4-step sequence from setup to parent report
const steps = [
  {
    step: "01",
    title: "Konfigurasi Jadwal & Santri",
    role: "Pengurus & Administrator",
    desc: "Admin mendaftarkan profil santri, menentukan jadwal rutin 5 sesi shalat mingguan, serta pengecualian hari libur. Sistem otomatis membuat tautan publik acak untuk setiap anak."
  },
  {
    step: "02",
    title: "Pencatatan Presensi & Materi",
    role: "Guru / Ustadz Pengajar",
    desc: "Guru membuka form absensi di musholla. Sistem mendeteksi sesi shalat otomatis. Guru memilih materi Iqro jilid 1-6 atau Surat Al-Qur'an, lalu menyimpan data bahkan saat kuota habis atau offline."
  },
  {
    step: "03",
    title: "Sinkronisasi Latar Belakang",
    role: "Sistem Otomatis (PWA)",
    desc: "Saat ponsel guru kembali mendeteksi sinyal internet atau WiFi, seluruh antrean lokal di IndexedDB langsung disinkronkan ke server secara kronologis tanpa mengganggu interaksi form."
  },
  {
    step: "04",
    title: "Rekap Transparan Orang Tua",
    role: "Wali Santri / Publik",
    desc: "Orang tua membuka tautan melalui WhatsApp tanpa perlu akun atau login. Mereka memantau perkembangan hafalan harian dan dapat langsung mengunduh lembar rekapitulasi PDF A4 siap cetak."
  }
];
---

<section id="alur" class="section-space">
  <div class="container scroll-reveal">
    <div class="section-head">
      <span class="section-eyebrow">Alur Kerja Praktis</span>
      <h2 class="section-title">Dari Musholla Langsung ke Tangan Orang Tua</h2>
      <p class="section-subtitle">
        Proses dirancang seringkas mungkin agar para ustadz fokus menyimak bacaan santri, bukan menghabiskan waktu berkutat dengan kerumitan aplikasi.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {steps.map((item) => (
        <div class="relative bg-[var(--paper)] border-2 border-[var(--border-strong)] rounded-[var(--radius-lg)] p-6 shadow-[var(--shadow-sm)] flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl font-extrabold text-[var(--forest)] font-['Bricolage_Grotesque'] tracking-tight">
                {item.step}
              </span>
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-[var(--radius-pill)] bg-[var(--sand)] text-[var(--ink)] border border-[var(--border-soft)]">
                {item.role}
              </span>
            </div>
            <h3 class="text-lg font-bold mb-2 text-[var(--ink)]">
              {item.title}
            </h3>
            <p class="text-sm text-[var(--ink-secondary)] leading-relaxed">
              {item.desc}
            </p>
          </div>
          <div class="mt-6 pt-3 border-t border-[var(--border-soft)] flex items-center text-xs font-semibold text-[var(--ink-muted)]">
            <span>Langkah terverifikasi dalam sistem</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
